{
  "name": "stoney",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "tag:sync": "git tag -f v1 && git push origin v1 --force",
    "dev:stoney": "pnpm -C packages/runner dev",
    "build": "pnpm -C packages/runner build",
    "build:runner": "pnpm -C packages/runner build",
    "stoney:run": "node packages/runner/dist/cli.cjs run --suite \"contracts/*.yml\" --report local-report.json",
    "release:patch": "gh workflow run Release -f bump=patch",
    "release:minor": "gh workflow run Release -f bump=minor",
    "release:major": "gh workflow run Release -f bump=major",
    "check:runner-dist": "pnpm -C packages/runner build && git diff --exit-code packages/runner/dist",
    "publish:runner": "cd packages/runner && pnpm publish --no-git-checks"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0"
  }
}
